{
  "name": "japanese-study",
  "productName": "일본어공부",
  "version": "0.2.0",
  "description": "매일 이어가는 일본어 공부",
  "author": "byeonggeun-jeong",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts --no-open",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vite build --config vite.server.config.ts",
    "make": "npm run typecheck && npm test && npm run validate:content && npm run build && tsx scripts/package.ts",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.9.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
